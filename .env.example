# Google Gemini API Key (Bắt buộc để chạy Gemini AI)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Alpha Vantage API Key (Tùy chọn - để trống sẽ tự động dùng Yahoo Finance Live Feed)
ALPHA_VANTAGE_API_KEY=

# Mô hình AI mặc định (gemini-3.6-flash, gemini-3.7-flash, gemini-3.5-flash-lite)
DEFAULT_AI_PROVIDER=Google Gemini
DEFAULT_MODEL=gemini-3.6-flash
